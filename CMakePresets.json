{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "pc-debug",
      "displayName": "PC Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "pc-release",
      "displayName": "PC Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "switch-release",
      "displayName": "Nintendo Switch Release",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/switch.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "VOXELGAME_BATTLE_DEFAULT": "ON",
        "VOXELGAME_DEPLOY_DIR": "D:/SDMC"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "pc-debug",
      "configurePreset": "pc-debug"
    },
    {
      "name": "pc-release",
      "configurePreset": "pc-release"
    },
    {
      "name": "switch-release",
      "configurePreset": "switch-release"
    }
  ],
  "testPresets": [
    {
      "name": "pc-debug",
      "configurePreset": "pc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "pc-release",
      "configurePreset": "pc-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

